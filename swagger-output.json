    "/event/{slug}": {
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "slug",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Get event by slug"
          }
        }
      },
      "put": {
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "slug",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 100
                  },
                  "description": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 2000
                  },
                  "address": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "longitude": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "latitude": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "start_date": {
                    "type": "string"
                  },
                  "end_date": {
                    "type": "string"
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "ART_CRAFT",
                      "FOOD_BEVERAGE",
                      "FASHION_BEAUTY",
                      "TECH_GADGETS",
                      "HOME_LIVING",
                      "CORPORATE_TRADE",
                      "ANIME_COMIC",
                      "THRIFT_VINTAGE",
                      "WELLNESS_FITNESS",
                      "PET_FAIR",
                      "EDUCATIONAL",
                      "OTHERS"
                    ]
                  },
                  "images": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 5
                  },
                  "booths": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "minimum": 0,
                          "exclusiveMinimum": true
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "price": {
                          "anyOf": [
                            {
                              "type": "number",
                              "minimum": 0
                            },
                            {
                              "type": "string",
                              "pattern": "^\\d+(\\.\\d+)?$"
                            }
                          ]
                        },
                        "type": {
                          "type": "string",
                          "enum": [
                            "AVAILABLE",
                            "RESERVED",
                            "SOLD",
                            "LOCKED"
                          ]
                        },
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        },
                        "width": {
                          "type": "number",
                          "minimum": 0,
                          "exclusiveMinimum": true
                        },
                        "height": {
                          "type": "number",
                          "minimum": 0,
                          "exclusiveMinimum": true
                        },
                        "rotation": {
                          "type": "number"
                        },
                        "description": {
                          "type": "string",
                          "maxLength": 1000
                        }
                      },
                      "required": [
                        "name",
                        "price",
                        "type",
                        "x",
                        "y",
                        "width",
                        "height",
                        "rotation"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event updated"
          }
        }
      }
    },
