{
  "version": 2,
  "builds": [
    {
      "src": "src/index.js", 
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/booking-cleanup",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/email-retry",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/email-sync",
      "schedule": "*/5 * * * *"
    }
  ]
}